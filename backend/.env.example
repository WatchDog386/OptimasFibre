# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Required ---
NODE_ENV=production
PORT=10000
# PostgreSQL on this server. Use the password you chose when creating the "optimas" database user.
DATABASE_URL=postgres://optimas:CHANGE_ME@127.0.0.1:5432/optimas
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Public address of the website (used for CORS, password-reset links and the logo on PDFs)
FRONTEND_URL=https://optimaswifi.co.ke

# --- Optional: login sessions ---
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Resend). Needed to email invoices, receipts and password-reset links ---
RESEND_API_KEY=
EMAIL_FROM=Optimas Fiber <billing@optimaswifi.co.ke>
EMAIL_TEST_RECIPIENT=

# --- Optional: first-run defaults for the company details printed on invoices/receipts.
#     After the first start these are edited in the dashboard (Settings). ---
COMPANY_NAME=
COMPANY_PHONE=
COMPANY_ADDRESS=
MPESA_PAYBILL=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# --- Optional: only if Chrome for PDFs is installed somewhere non-standard ---
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
